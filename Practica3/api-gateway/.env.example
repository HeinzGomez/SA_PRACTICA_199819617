# Puerto HTTP publico del API Gateway (unico punto de entrada north-south)
PORT=8080
NODE_ENV=development

# Dominios institucionales permitidos para registro/login (separados por coma)
ALLOWED_EMAIL_DOMAINS=ingenieria.usac.edu.gt,ing.usac.edu.gt

# JWT
JWT_SECRET=change-me-in-.env
JWT_EXPIRES_IN=8h

# Session cookies
SESSION_COOKIE_NAME=yousac_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true

# OAuth 2.0 institucional
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/auth/oauth/callback
OAUTH_ISSUER_URL=

# Direcciones internas de los microservicios (gRPC, east-west)
IDENTITY_SERVICE_GRPC_URL=identity-service:50051
CONTENT_SERVICE_GRPC_URL=content-service:50052
ANALYTICS_SERVICE_GRPC_URL=analytics-service:50053

# CORS
WEB_CLIENT_ORIGIN=http://localhost:5173
