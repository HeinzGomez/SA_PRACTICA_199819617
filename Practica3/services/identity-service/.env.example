# Puerto gRPC interno (east-west), no expuesto publicamente
GRPC_PORT=50051

# PostgreSQL propio de este microservicio (Database per Microservice).
# NOTA: al correr via docker-compose.local.yml/.cloud.yml, estos 5 valores
# se sobreescriben automaticamente desde el .env de la RAIZ del repo
# (fuente unica de verdad). Solo se usan tal cual si corres el servicio
# suelto con "npm run dev" fuera de Docker.
DB_HOST=identity-db
DB_PORT=5432
DB_NAME=identity_db
DB_USER=identity_user
DB_PASSWORD=change-me-in-.env

# JWT para comunicacion service-to-service (validado tambien por el Gateway)
JWT_SECRET=change-me-in-.env
JWT_EXPIRES_IN=8h

# Dominios institucionales permitidos
ALLOWED_EMAIL_DOMAINS=ingenieria.usac.edu.gt,ing.usac.edu.gt
