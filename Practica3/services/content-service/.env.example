# Puerto gRPC interno (east-west)
GRPC_PORT=50052
# Puerto HTTP solo para healthcheck interno (no expuesto al cliente)
HTTP_PORT=8082

# PostgreSQL propio de este microservicio (Database per Microservice).
# NOTA: al correr via docker-compose.local.yml/.cloud.yml, estos 5 valores
# se sobreescriben automaticamente desde el .env de la RAIZ del repo.
DB_HOST=content-db
DB_PORT=5432
DB_NAME=content_db
DB_USER=content_user
DB_PASSWORD=change-me-in-.env
