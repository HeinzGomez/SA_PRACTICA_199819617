# Puerto gRPC interno (east-west)
GRPC_PORT=50053
# Puerto HTTP solo para healthcheck interno
HTTP_PORT=8083

# PostgreSQL propio de este microservicio (Database per Microservice).
# NOTA: al correr via docker-compose.local.yml/.cloud.yml, estos 5 valores
# (y los de Redis) se sobreescriben automaticamente desde el .env de la
# RAIZ del repo.
DB_HOST=analytics-db
DB_PORT=5432
DB_NAME=analytics_db
DB_USER=analytics_user
DB_PASSWORD=change-me-in-.env

# Redis (cache obligatoria de tendencias/analitica, con TTL)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300

# SMTP institucional para notificaciones por correo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change-me-in-.env
SMTP_PASSWORD=change-me-in-.env
SMTP_FROM=notificaciones@yousac.ingenieria.usac.edu.gt
