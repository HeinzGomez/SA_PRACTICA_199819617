{
  "name": "academix-pass-frontend",
  "version": "1.0.0",
  "private": true,
  "description": "HeinzGomez - Práctica 7: Frontend YOUSAC Academix Pass & CertiHub (Next.js en Vercel)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test": "jest --coverage"
  },
  "dependencies": {
    "next": "15.5.26",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1"
    },
    "collectCoverageFrom": [
      "lib/**/*.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "jsx": "react-jsx",
            "module": "commonjs"
          }
        }
      ]
    }
  },
  "engines": {
    "node": ">=20"
  }
}
