# Archivo generado por Ansible (playbooks/entorno.yml).
# Los valores salen de group_vars/all.yml: cambia ahí y vuelve a correr site.yml.
# Si editas este archivo a mano, en el siguiente run Ansible guarda una copia
# con sufijo .bak-<fecha>.

# ---------------------------------------------------------------
# Proxy inverso y certificados
# ---------------------------------------------------------------

# Correo para avisos de expiración de Let's Encrypt
LETSENCRYPT_EMAIL={{ letsencrypt_email }}

# URL exacta que te asigne Vercel para mayor seguridad (opcional, si no la pones usará *)
CORS_ORIGINS={{ cors_origins }}

# Dominio de este servidor. Por defecto el compose usa academixdev.yo-usac.com;
# descomenta solo si necesitas sobreescribirlo.
# VIRTUAL_HOST=academixdev.yo-usac.com
# LETSENCRYPT_HOST=academixdev.yo-usac.com

# ---------------------------------------------------------------
# Imágenes publicadas en ghcr.io
# ---------------------------------------------------------------
IMAGE_TAG={{ image_tag }}

# ---------------------------------------------------------------
# Recuerda poner las demás variables de la BD, JWT, etc. que tu app necesite
# ---------------------------------------------------------------

# Base de datos
POSTGRES_PASSWORD={{ postgres_password }}

# Mensajería
RABBITMQ_USER={{ rabbitmq_user }}
RABBITMQ_PASS={{ rabbitmq_pass }}

# Seguridad de la aplicación
JWT_SECRET={{ jwt_secret }}
ADMIN_PASSWORD={{ admin_password }}
CERT_SIGNING_SEED={{ cert_signing_seed }}
