# Terraform · estado local, variables con valores reales y artefactos.

# Estado: si se subiera, cualquiera ve las IPs, dependencias y valores aplicados.
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*

# Planes: contienen el diff completo con los valores sensibles.
tfplan*
*.tfplan

# Variables con valores reales. Solo se versionan terraform.tfvars.example y
# terraform.tfvars (no contiene secretos: solo proyecto, region, hostnames y CIDRs;
# el CI lo necesita para aplicar la infra).
*.tfvars
*.auto.tfvars
!*.tfvars.example
!terraform.tfvars

# Volcados de pánico y overrides locales.
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Bloqueo de estado (se genera solo mientras terraform corre).
.terraform.tfstate.lock.info
