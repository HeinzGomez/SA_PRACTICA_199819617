# HeinzGomez - Práctica 10: secretos propios de cada servicio (no van en datos-conexiones).
#
# PLANTILLA renderizada por ansible/playbooks/despliegue-k3s.yml desde
# ansible/group_vars/all/99-secretos.yml (fuente única de credenciales, gitignored).
apiVersion: v1
kind: Secret
metadata:
  name: secretos-servicios
  namespace: academix
  labels:
    app.kubernetes.io/part-of: academix
type: Opaque
stringData:
  # auth-service
  JWT_SECRET: "{{ jwt_secret }}"
  ADMIN_PASSWORD: "{{ admin_password }}"

  # certificados-service (semilla de la firma de certificados)
  CERT_SIGNING_SEED: "{{ cert_signing_seed }}"

  # grafana (UI de monitoreo; los mismos valores por defecto que en compose)
  GRAFANA_ADMIN_USER: "{{ grafana_admin_user }}"
  GRAFANA_ADMIN_PASSWORD: "{{ grafana_admin_password }}"

  # rabbitmq (credenciales del broker desplegado en el cluster; debe coincidir
  # con RABBITMQ_URL de datos-conexiones)
  RABBITMQ_DEFAULT_USER: "guest"
  RABBITMQ_DEFAULT_PASS: "{{ rabbitmq_pass }}"
