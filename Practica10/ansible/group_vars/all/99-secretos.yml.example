---
# EJEMPLO · copia a 99-secretos.yml y pon tus valores reales:
#   cp 99-secretos.yml.example 99-secretos.yml
#
# 99-secretos.yml está en .gitignore: se queda en tu máquina y no se sube.
# Este fichero .example sí se versiona, para que quien clone el repo sepa
# qué variables hacen falta.

postgres_password: CAMBIAR_POSTGRES_PASSWORD
rabbitmq_pass: CAMBIAR_RABBITMQ_PASS

jwt_secret: CAMBIAR_JWT_SECRET
admin_password: CAMBIAR_ADMIN_PASSWORD
cert_signing_seed: CAMBIAR_CERT_SIGNING_SEED
